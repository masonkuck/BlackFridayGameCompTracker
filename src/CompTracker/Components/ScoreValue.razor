@* A displayed score with its type icon in front: a clock for speedrun times, a star for point scores. *@

<span class="score-value @Class"><Icon Name="@IconName(Type)" Class="score-icon" />@ScoreFormat.Format(Type, Value)</span>

@code {
    [Parameter, EditorRequired] public ScoringType Type { get; set; }
    [Parameter, EditorRequired] public decimal Value { get; set; }
    [Parameter] public string? Class { get; set; }

    public static string IconName(ScoringType type) => type == ScoringType.TimeLowest ? "clock" : "star";
}
