@implements IDisposable
@inject ScoringService Scoring
@inject BracketAdmin Brackets
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ChangeNotifier Notifier

@* The admin side of a bracket game (shown on its game page), all on the bracket itself:
   while setting up, drag players between first-round slots; once locked in, click a player to make them the winner. *@

@if (error is not null)
{
    <p class="error">@error</p>
}

@if (view is null)
{
    <p class="muted">Loading…</p>
}
else if (view.State is not { } state)
{
    <section class="panel bracket-admin">
        <h2><span><Icon Name="tree-structure" Class="accent" /> No bracket yet</span></h2>
        <p class="muted">
            Drawing puts every active player (@activePlayers.Count) into a random double-elimination bracket.
            You can rearrange the matchups before you lock it in.
        </p>
        <button class="btn primary" @onclick="DrawAsync" disabled="@(activePlayers.Count < BracketEngine.MinPlayers)">
            <Icon Name="shuffle" /> Draw the bracket
        </button>
    </section>
}
else
{
    var locked = view.Game.BracketLocked;
    <div class="bracket-status">
        @if (!locked)
        {
            <span class="status-pill setup"><Icon Name="shuffle" /> Setting up</span>
            <span class="muted small">Drag a player onto another slot to swap them (or tap one, then the other). Lock it in when the matchups look right.</span>
        }
        else if (state.Finished)
        {
            <span class="status-pill done"><Icon Name="crown" /> @view.Name(state.ChampionId!.Value) won</span>
            <span class="muted small">Click the loser of any match to flip it, or <Icon Name="arrow-counter-clockwise" /> to undo it.</span>
        }
        else
        {
            <span class="status-pill live"><Icon Name="sword" /> Locked in</span>
            <span class="muted small">Click the player who won a highlighted match. Click a loser to flip a result, or <Icon Name="arrow-counter-clockwise" /> to undo one.</span>
        }
    </div>

    <div class="bracket-toolbar">
        @if (!locked)
        {
            <button class="btn primary" @onclick="LockAsync"><Icon Name="check-circle" /> Lock in bracket</button>
            <button class="btn" @onclick="ConfirmRedraw"><Icon Name="shuffle" /> Redraw</button>
        }
        else if (!state.Started)
        {
            <button class="btn" @onclick="UnlockAsync">Unlock matchups</button>
        }
        else
        {
            <button class="btn danger" @onclick="ConfirmReset"><Icon Name="arrow-counter-clockwise" /> Reset results</button>
        }
        <a class="btn" href="brackets/@GameId" target="_blank"><Icon Name="tree-structure" /> Open bracket screen</a>
        <button class="btn danger" @onclick="ConfirmRemove">Remove bracket</button>
    </div>

    @if (!locked && missing.Count > 0)
    {
        <p class="warn-text small">
            Not in the bracket: @string.Join(", ", missing.Select(p => p.Name)).
            @(state.Slots.Contains(0) ? "Redraw to include them." : "There's no free slot; redraw to make room.")
        </p>
    }

    <section class="panel bracket-panel">
        <BracketTree View="view" Mode="@(locked ? BracketTreeMode.Play : BracketTreeMode.Arrange)"
                     OnSwap="SwapAsync" OnPick="ConfirmPickAsync" OnUndo="ConfirmUndoAsync" />
    </section>
}

<Modal IsOpen="confirm is not null" Title="@(confirm?.Title ?? "")" OnClose="() => confirm = null">
    @if (confirm is not null)
    {
        <div class="modal-body">
            <p class="confirm-message">@confirm.Message</p>
            @if (confirm.Lost > 0)
            {
                <p class="warn-text small">
                    This also clears @confirm.Lost later @(confirm.Lost == 1 ? "result" : "results") that depended on it.
                </p>
            }
            <div class="modal-actions">
                <button class="btn" type="button" @onclick="() => confirm = null">Cancel</button>
                <button class="btn @(confirm.Danger ? "danger" : "primary")" type="button" @onclick="RunConfirmedAsync">@confirm.Action</button>
            </div>
        </div>
    }
</Modal>

@code {
    [Parameter, EditorRequired] public int GameId { get; set; }

    private BracketView? view;
    private List<Player> activePlayers = [];
    private List<Player> missing = [];
    private string? error;
    private Confirmation? confirm;

    // "Are you sure?" for anything that changes results or throws matchups away.
    private record Confirmation(string Title, RenderFragment Message, string Action, Func<Task<string?>> Run, int Lost = 0, bool Danger = false);

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        Notifier.Changed -= OnDataChanged;
        Notifier.Changed += OnDataChanged;
    }

    private async Task LoadAsync()
    {
        view = await Scoring.GetBracketAsync(GameId);
        await using var db = await DbFactory.CreateDbContextAsync();
        activePlayers = await db.Players.AsNoTracking().Where(p => p.IsActive).OrderBy(p => p.Name).ToListAsync();
        var slotted = view?.State?.Slots.ToHashSet() ?? [];
        missing = activePlayers.Where(p => !slotted.Contains(p.Id)).ToList();
    }

    // Other pages (or another admin tab) changed something: show it.
    private void OnDataChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task SwapAsync((int From, int To) swap)
    {
        if (view?.State is not { } state)
            return;
        var slots = state.Slots.ToList();
        (slots[swap.From], slots[swap.To]) = (slots[swap.To], slots[swap.From]);
        await RunAsync(() => Brackets.SetSlotsAsync(GameId, slots));
    }

    private Task DrawAsync() => RunAsync(() => Brackets.DrawAsync(GameId));
    private Task LockAsync() => RunAsync(() => Brackets.SetLockedAsync(GameId, true));
    private Task UnlockAsync() => RunAsync(() => Brackets.SetLockedAsync(GameId, false));

    private async Task ConfirmPickAsync((BracketMatch Match, int WinnerId) pick)
    {
        var (m, winner) = pick;
        var loser = winner == m.A.PlayerId ? m.B.PlayerId : m.A.PlayerId;
        var round = view!.State!.RoundName(m);
        var lost = await Brackets.ResultsLostIfAsync(GameId, m.Key, winner);
        RenderFragment message = m.Decided
            ? @<text>Change it so <strong>@view.Name(winner)</strong> beat <strong>@view.Name(loser)</strong>?<span class="confirm-round">@round</span></text>
            : @<text><strong>@view.Name(winner)</strong> beat <strong>@view.Name(loser)</strong>?<span class="confirm-round">@round</span></text>;
        confirm = new Confirmation(m.Decided ? "Change the result?" : "Confirm the result", message,
            m.Decided ? $"Yes, {view.Name(winner)} won" : $"{view.Name(winner)} won",
            () => Brackets.SetWinnerAsync(GameId, m.Key, winner), lost);
    }

    private async Task ConfirmUndoAsync(BracketMatch m)
    {
        var lost = await Brackets.ResultsLostIfAsync(GameId, m.Key, null);
        var round = view!.State!.RoundName(m);
        RenderFragment message = @<text>Undo <strong>@view.Name(m.WinnerId!.Value)</strong>'s win over <strong>@view.Name(m.LoserId!.Value)</strong>?<span class="confirm-round">@round</span></text>;
        confirm = new Confirmation("Undo this result?", message, "Undo it", () => Brackets.ClearResultAsync(GameId, m.Key), lost, Danger: true);
    }

    private void ConfirmRedraw() =>
        confirm = new Confirmation("Redraw the bracket?", @<text>Every active player is shuffled into new matchups.</text>, "Redraw",
            () => Brackets.DrawAsync(GameId));

    private void ConfirmReset() =>
        confirm = new Confirmation("Reset all results?", @<text>Every result in this bracket is cleared. The matchups stay locked in.</text>, "Reset results",
            async () => { await Brackets.ResetResultsAsync(GameId); return null; }, Danger: true);

    private void ConfirmRemove() =>
        confirm = new Confirmation("Remove the bracket?", @<text>The matchups and every result are deleted.</text>, "Remove bracket",
            async () => { await Brackets.RemoveAsync(GameId); return null; }, Danger: true);

    private async Task RunConfirmedAsync()
    {
        var run = confirm!.Run;
        confirm = null;
        await RunAsync(run);
    }

    private async Task RunAsync(Func<Task<string?>> action)
    {
        error = await action();
        await LoadAsync();
    }

    public void Dispose() => Notifier.Changed -= OnDataChanged;
}
