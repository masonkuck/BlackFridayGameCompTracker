@page "/"
@implements IDisposable
@inject ScoringService Scoring
@inject ChangeNotifier Notifier
@inject IConfiguration Config
@inject AdminSession AdminSession
@inject IJSRuntime JS
@inject JoinLink Join

<PageTitle>Leaderboard · @EventName</PageTitle>

<div class="dashboard">
    <header class="dash-header">
        <h1>@EventName</h1>
        <div class="dash-actions">
            @if (joinUrl is not null)
            {
                <button type="button" class="qr-toggle" data-qr-toggle title="Show the QR code for phones"><Icon Name="qr-code" /></button>
            }
            @* Wired up in app.js; its look follows <html data-sound>. *@
            <button type="button" class="sound-toggle" data-sound-toggle title="Sound effects">
                <span class="sound-on"><Icon Name="speaker-high" /> Sound on</span>
                <span class="sound-off"><Icon Name="speaker-slash" /> Sound off</span>
                <span class="sound-blocked"><Icon Name="speaker-slash" /> Click to enable sound</span>
            </button>
            <a class="admin-link" href="admin/games"><Icon Name="gear-six" Title="Admin" /></a>
        </div>
    </header>

    @if (leaderboard is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (leaderboard.Count == 0)
    {
        <p class="muted big-empty">No players yet. Add them under <a href="admin/players">Admin → Players</a>.</p>
    }
    else
    {
        <div class="dash-grid">
            <section class="panel">
                <h2><span><Icon Name="trophy" Class="gold" /> Leaderboard</span></h2>
                <ol class="leaderboard">
                    @foreach (var row in leaderboard)
                    {
                        var pct = row.GamesTotal == 0 ? 0 : row.GamesDone * 100 / row.GamesTotal;
                        <li class="lb-row rank-@Math.Min(row.Rank, 4)">
                            <span class="lb-rank">@row.Rank</span>
                            <span class="lb-name">
                                @row.PlayerName
                                @if (row.FirstPlaces > 0)
                                {
                                    <span class="firsts" title="1st places"><Icon Name="medal" /> ×@row.FirstPlaces</span>
                                }
                                <span class="progress" title="@row.GamesDone of @row.GamesTotal games played">
                                    <span class="progress-fill" style="width:@(pct)%"></span>
                                </span>
                            </span>
                            <span class="lb-done">@row.GamesDone/@row.GamesTotal</span>
                            <span class="lb-points">@row.TotalPoints<small>pts</small></span>
                        </li>
                    }
                </ol>
            </section>

            <div class="dash-side">
            @if (games.Count > 0)
            {
                <section class="panel">
                    <h2><span><Icon Name="medal" Class="accent" /> Games</span></h2>
                    <div class="game-cards">
                        @foreach (var g in games)
                        {
                            var leaders = g.Standings.Where(s => s.Place == 1).ToList();
                            var pct = playerCount == 0 ? 0 : g.Standings.Count * 100 / playerCount;
                            <a class="game-card" href="games/@g.GameId" data-game-id="@g.GameId">
                                <span class="game-card-head">
                                    <span class="game-card-title">@g.Title</span>
                                    <span class="badge @g.ScoringType">@g.ScoringType.ShortLabel()</span>
                                </span>
                                @if (leaders.Count == 0)
                                {
                                    <span class="game-card-leader muted">No scores yet</span>
                                }
                                else
                                {
                                    <span class="game-card-leader">
                                        <Icon Name="crown" Class="gold" />
                                        <span class="leader-name">@string.Join(" & ", leaders.Select(l => l.PlayerName))</span>
                                        <ScoreValue Type="g.ScoringType" Value="leaders[0].Value" Class="leader-result" />
                                    </span>
                                }
                                <span class="game-card-foot">
                                    <span class="progress"><span class="progress-fill" style="width:@(pct)%"></span></span>
                                    <span class="muted small">@g.Standings.Count/@playerCount</span>
                                </span>
                            </a>
                        }
                    </div>
                </section>
            }

            <section class="panel">
                <h2>
                    <span><Icon Name="game-controller" Class="accent" /> Still to play</span>
                    @if (pageCount > 1)
                    {
                        <span class="pager">
                            <button type="button" class="pager-btn" title="Previous" @onclick="() => MovePage(-1)"><Icon Name="caret-left" /></button>
                            <span class="page-dots">
                                @for (var i = 0; i < pageCount; i++)
                                {
                                    <span class="dot @(i == pageIndex ? "on" : "")"></span>
                                }
                            </span>
                            <button type="button" class="pager-btn" title="Next" @onclick="() => MovePage(1)"><Icon Name="caret-right" /></button>
                        </span>
                    }
                </h2>

                @if (remaining.Count == 0)
                {
                    <p class="all-done"><Icon Name="confetti" Class="gold" /> Everyone has played every game!</p>
                }
                else
                {
                    <div class="todo-page" @key="pageIndex">
                        @foreach (var todo in remaining.Skip(pageIndex * PageSize).Take(PageSize))
                        {
                            <div class="todo-card">
                                <div class="todo-name">@todo.PlayerName <span class="muted">· @todo.RemainingGames.Count left</span></div>
                                <ul class="todo-games">
                                    @foreach (var g in todo.RemainingGames)
                                    {
                                        <li>@g</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }

                @if (finished.Count > 0)
                {
                    <div class="finished">
                        <span class="muted"><Icon Name="check-circle" Class="ok-text" /> All done:</span>
                        @foreach (var f in finished)
                        {
                            <span class="chip">@f.PlayerName</span>
                        }
                    </div>
                }
            </section>
            </div>
        </div>
    }
</div>

@if (recent.Count > 0)
{
    @* Items are rendered twice so the scroll loops seamlessly (the track slides by exactly half its width). *@
    <div class="ticker" aria-label="Recently posted scores">
        <span class="ticker-label"><Icon Name="timer" /> Latest</span>
        <div class="ticker-viewport">
            <div class="ticker-track" style="animation-duration:@(Math.Max(recent.Count * 6, 20))s">
                @for (var copy = 0; copy < 2; copy++)
                {
                    <span class="ticker-group" aria-hidden="@(copy == 1 ? "true" : null)">
                        @foreach (var r in recent)
                        {
                            <span class="ticker-item">
                                <strong>@r.Standing.PlayerName</strong>
                                <span class="muted">posted</span>
                                <ScoreValue Type="r.Game.ScoringType" Value="r.Standing.Value" Class="accent" />
                                <span class="muted">in</span> @r.Game.Title
                                <span class="ticker-place @PlaceClass(r.Standing.Place)">@ScoreFormat.Ordinal(r.Standing.Place)</span>
                                <span class="muted small">@r.Standing.UpdatedAt.ToLocalTime().ToString("h:mm tt")</span>
                            </span>
                        }
                    </span>
                }
            </div>
        </div>
    </div>
}

@if (joinUrl is not null)
{
    @* Shown/hidden by app.js (<html data-qr>), remembered per browser. *@
    <aside class="join-card" aria-label="Open on your phone">
        <button type="button" class="join-close" data-qr-toggle title="Hide"><Icon Name="x-circle" /></button>
        <div class="join-qr">@((MarkupString)Join.QrSvg(joinUrl))</div>
        <div class="join-text">
            <strong>Live scores on your phone</strong>
            <span class="muted">Scan, or go to</span>
            <code>@joinUrl.TrimEnd('/')</code>
        </div>
    </aside>
}

<CelebrationOverlay @ref="celebration" />

@code {
    private const int PageSize = 3;
    private static readonly TimeSpan RotateEvery = TimeSpan.FromSeconds(7);

    private IReadOnlyList<LeaderboardRow>? leaderboard;
    private List<TodoRow> remaining = [];
    private List<TodoRow> finished = [];
    private IReadOnlyList<GameSummary> games = [];
    private IReadOnlyList<RecentScore> recent = [];
    private int playerCount;
    private int pageIndex;
    private CelebrationOverlay? celebration;
    private string? joinUrl;
    private int pageCount => (remaining.Count + PageSize - 1) / PageSize;

    private readonly CancellationTokenSource cts = new();
    private CancellationTokenSource? rotateCts;

    private string EventName => Config["EventName"] ?? "Gaming Tournament";

    protected override async Task OnInitializedAsync()
    {
        // Leaving admin for the dashboard ends the admin session; the PIN is needed again.
        AdminSession.Lock();
        joinUrl = Join.Url;
        await LoadAsync();
        Notifier.Changed += OnDataChanged;
        Notifier.ScorePosted += OnScorePosted;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            RestartRotation();
    }

    private async Task LoadAsync()
    {
        var data = await Scoring.GetDashboardAsync();
        leaderboard = data.Leaderboard;
        remaining = data.Todo.Where(t => t.RemainingGames.Count > 0).ToList();
        finished = data.Todo.Where(t => t.RemainingGames.Count == 0).ToList();
        games = data.Games;
        recent = data.Recent;
        playerCount = data.PlayerCount;
        if (pageIndex >= pageCount)
            pageIndex = 0;
    }

    private static string PlaceClass(int place) => ScoreFormat.PlaceClass(place);

    // Manual paging restarts the timer so the page you picked stays up for a full interval.
    private void MovePage(int step)
    {
        if (pageCount <= 1)
            return;
        pageIndex = (pageIndex + step + pageCount) % pageCount;
        RestartRotation();
    }

    private void RestartRotation()
    {
        rotateCts?.Cancel();
        rotateCts?.Dispose();
        rotateCts = CancellationTokenSource.CreateLinkedTokenSource(cts.Token);
        _ = RotateLoopAsync(rotateCts.Token);
    }

    private async Task RotateLoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(RotateEvery);
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (pageCount <= 1)
                    continue;
                await InvokeAsync(() =>
                {
                    pageIndex = (pageIndex + 1) % pageCount;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnDataChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    // A ping and a card glow for every posted score; a new leader gets the full celebration (and its own sound) instead.
    private void OnScorePosted(ScorePosted posted) => _ = InvokeAsync(async () =>
    {
        try
        {
            await JS.InvokeVoidAsync("compTracker.flashGame", posted.GameId);
            if (posted.Celebrations.Count == 0)
                await JS.InvokeVoidAsync("compTracker.sound.play", "ping");
        }
        catch (JSDisconnectedException)
        {
        }
        celebration?.Enqueue(posted.Celebrations);
    });

    public void Dispose()
    {
        Notifier.Changed -= OnDataChanged;
        Notifier.ScorePosted -= OnScorePosted;
        cts.Cancel();
        rotateCts?.Dispose();
        cts.Dispose();
    }
}
